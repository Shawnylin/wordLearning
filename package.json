{
  "name": "word-learning-app",
  "private": true,
  "version": "0.5.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "vue-tsc && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "serve": "node server/serve.mjs",
    "worker:dev": "npx --yes wrangler@4.37.1 dev",
    "worker:deploy": "npx --yes wrangler@4.37.1 deploy"
  },
  "dependencies": {
    "lucide-vue-next": "^0.462.0",
    "pdfjs-dist": "^5.4.624",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "^3.2.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vue-tsc": "^2.2.0"
  }
}
